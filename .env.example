# Copy to .env and fill in. Never commit .env.

API_PORT=8787
APP_URL=http://localhost:5180
DATABASE_PATH=data/mergewatch.db

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# GitHub OAuth App (github.com/settings/developers > New OAuth App)
#   Homepage URL:               http://localhost:5180
#   Authorization callback URL: http://localhost:5180/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: only let members of this GitHub org sign in (worth setting if you ever host it).
GITHUB_ALLOWED_ORG=

# Atlassian OAuth 2.0 (3LO) app (developer.atlassian.com/console/myapps)
#   Permissions: Jira API, scopes read:jira-work and read:jira-user
#   Callback URL: http://localhost:5180/auth/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

POLL_INTERVAL_SECONDS=60

# Agent stays off until an Enflux-approved provider is confirmed.
# To enable: AGENT_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
AGENT_PROVIDER=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# Sample data and a local sign-in without GitHub. For local demos only.
DEMO_MODE=0
